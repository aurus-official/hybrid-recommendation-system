package rules.soil

import com.aurus.server.engine.EngineCategoryOutputDTO;
import com.aurus.server.batch.derive.weather.DerivedWeatherDataModel;
import com.aurus.server.batch.derive.sensor.DerivedSensorDataModel;
import com.aurus.server.shared.PriorityLevel;
import com.aurus.server.shared.SeverityLevel;
import com.aurus.server.shared.CategoryType;

global java.util.List intermediateOutputs;


/* =========================================================
   FACTORY FUNCTION
   ========================================================= */

function EngineCategoryOutputDTO buildSoilOutput(
    String action,
    SeverityLevel severity,
    PriorityLevel priority,
    float confidence
) {
    EngineCategoryOutputDTO out = new EngineCategoryOutputDTO();

    out.setCategoryType(CategoryType.SOIL_NUTRIENT);
    out.setAction(action);
    out.setSeverityLevel(severity);
    out.setPriorityLevel(priority);

    float c = confidence;

    if (c < 0f) c = 0f;
    if (c > 1f) c = 1f;

    out.setConfidence(c);

    return out;
}


/* =========================================================
   CRITICAL - SUSPEND FERTILIZER
   ========================================================= */

rule "Soil - Suspend Fertilizer Application"
salience 100
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex < 0.45f
    )

    $w : DerivedWeatherDataModel()
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        (0.55f * (1f - sfi))
        +
        (0.45f * $w.getRainImpactIndex());

    String action =
        "Soil fertility index is critically low (" +
        String.format("%.2f", sfi) +
        "). Suspend fertilizer application temporarily due to elevated nutrient leaching risk from expected rainfall.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.CRITICAL,
            PriorityLevel.P0,
            confidence
        )
    );
end


/* =========================================================
   CRITICAL - DELAY FERTILIZATION
   ========================================================= */

rule "Soil - Delay Fertilization"
salience 95
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex < 0.40f
    )

    $w : DerivedWeatherDataModel(
        rainImpactIndex >= 0.65f,
        rainImpactIndex < 0.85f
    )
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        (0.60f * (1f - sfi))
        +
        (0.40f * $w.getRainImpactIndex());

    String action =
        "Soil fertility index is " +
        String.format("%.2f", sfi) +
        " with significant rainfall influence detected. Delay fertilizer application until soil moisture and weather conditions stabilize.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.CRITICAL,
            PriorityLevel.P0,
            confidence
        )
    );
end


/* =========================================================
   HIGH - IMMEDIATE NUTRIENT RECOVERY
   ========================================================= */

rule "Soil - Immediate Nutrient Recovery"
salience 92
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex < 0.25f
    )

    $w : DerivedWeatherDataModel(
        rainImpactIndex < 0.65f
    )
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        (0.75f * (1f - sfi))
        +
        (0.25f * (1f - $w.getRainImpactIndex()));

    String action =
        "Soil fertility index is extremely low (" +
        String.format("%.2f", sfi) +
        "). Apply immediate nutrient recovery measures and reassess soil conditions during the next monitoring cycle.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        )
    );
end


/* =========================================================
   HIGH - INCREASE FERTILITY SUPPORT
   ========================================================= */

rule "Soil - Increase Fertility Support"
salience 90
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex >= 0.25f,
        soilFertilityIndex < 0.40f
    )

    $w : DerivedWeatherDataModel(
        rainImpactIndex < 0.65f
    )
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        (0.70f * (1f - sfi))
        +
        (0.30f * (1f - $w.getRainImpactIndex()));

    String action =
        "Soil fertility index is below the desired range (" +
        String.format("%.2f", sfi) +
        "). Increase nutrient support gradually and monitor soil fertility trends before the next fertilization cycle.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        )
    );
end


/* =========================================================
   MODERATE - MAINTAIN STABILITY
   ========================================================= */

rule "Soil - Maintain Nutrient Stability"
salience 80
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex >= 0.40f,
        soilFertilityIndex < 0.60f
    )
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        1f - Math.abs(sfi - 0.50f);

    String action =
        "Soil fertility index is within the acceptable operating range (" +
        String.format("%.2f", sfi) +
        "). Maintain the current nutrient program and continue routine monitoring.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.MODERATE,
            PriorityLevel.P2,
            confidence
        )
    );
end


/* =========================================================
   LOW - BALANCED CONDITION
   ========================================================= */

rule "Soil - Balanced Nutrient Condition"
salience 70
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex >= 0.60f,
        soilFertilityIndex < 0.80f
    )

    $w : DerivedWeatherDataModel()
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        (0.75f * sfi)
        +
        (0.25f * $w.getWaterBalanceIndex());

    String action =
        "Soil fertility index is healthy (" +
        String.format("%.2f", sfi) +
        "). Maintain balanced nutrient management and avoid unnecessary fertilizer additions.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.LOW,
            PriorityLevel.P3,
            confidence
        )
    );
end


/* =========================================================
   LOW - EXCESS NUTRIENT CONDITION
   ========================================================= */

rule "Soil - Reduce Excess Nutrient Input"
salience 65
when
    $s : DerivedSensorDataModel(
        soilFertilityIndex >= 0.80f
    )

    $w : DerivedWeatherDataModel()
then

    float sfi = $s.getSoilFertilityIndex();

    float confidence =
        (0.80f * sfi)
        +
        (0.20f * $w.getWaterBalanceIndex());

    String action =
        "Soil fertility index is elevated (" +
        String.format("%.2f", sfi) +
        "). Reduce additional fertilizer inputs and prioritize nutrient-use efficiency.";

    intermediateOutputs.add(
        buildSoilOutput(
            action,
            SeverityLevel.LOW,
            PriorityLevel.P3,
            confidence
        )
    );
end


/* =========================================================
   FALLBACK
   ========================================================= */

rule "Soil - Default Soil Monitoring"
salience -999
when
    $s : DerivedSensorDataModel()
then

    intermediateOutputs.add(
        buildSoilOutput(
            "Continue monitoring soil fertility conditions and reassess nutrient management requirements during the next recommendation cycle.",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            0.05f
        )
    );
end
