package rules.irrigation

import com.aurus.server.engine.EngineCategoryOutputDTO;
import com.aurus.server.batch.derive.weather.DerivedWeatherDataModel;
import com.aurus.server.batch.derive.sensor.DerivedSensorDataModel;
import com.aurus.server.shared.PriorityLevel;
import com.aurus.server.shared.SeverityLevel;
import com.aurus.server.shared.CategoryType;

global java.util.List intermediateOutputs;


/* =========================================================
   FACTORY FUNCTION (WITH GLOBAL CONFIDENCE SCALING)
   ========================================================= */
function EngineCategoryOutputDTO buildIrrigationOutput(
    String action,
    SeverityLevel severity,
    PriorityLevel priority,
    float confidence
) {
    EngineCategoryOutputDTO out = new EngineCategoryOutputDTO();

    out.setCategoryType(CategoryType.IRRIGATION);
    out.setAction(action);
    out.setSeverityLevel(severity);
    out.setPriorityLevel(priority);

    float multiplier;

    if (severity == SeverityLevel.CRITICAL) {
        multiplier = 1.15f;
    } else if (severity == SeverityLevel.HIGH) {
        multiplier = 1.08f;
    } else if (severity == SeverityLevel.MODERATE) {
        multiplier = 1.00f;
    } else {
        multiplier = 0.95f;
    }

    float c = confidence * multiplier;

    if (c < 0f) c = 0f;
    if (c > 1f) c = 1f;

    out.setConfidence(c);

    return out;
}


/* =========================================================
   CRITICAL - EMERGENCY IRRIGATION
   ========================================================= */
rule "IRR - Emergency Irrigation"
salience 100
when
    $s : DerivedSensorDataModel(
        combinedSoilMoisture < 0.25f
    )

    $w : DerivedWeatherDataModel()
then
    float sm = $s.getCombinedSoilMoisture();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.65f * (1f - sm))
      + (0.25f * dry)
      + (0.10f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildIrrigationOutput(
            "apply_emergency_irrigation",
            SeverityLevel.CRITICAL,
            PriorityLevel.P0,
            confidence
        );

    out.setRationale(
        "Critical soil moisture deficit detected with elevated drying conditions."
    );

    out.addEvidence(
        "Soil Moisture",
        sm,
        0.25f,
        "<"
    );

    out.addEvidence(
        "Evaporation Drying Risk",
        dry,
        0.70f,
        ">"
    );

    out.addEvidence(
        "Rain Impact Index",
        rain,
        0.75f,
        "<"
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   HIGH - INCREASE IRRIGATION
   ========================================================= */
rule "IRR - Increase Irrigation"
salience 90
when
    $s : DerivedSensorDataModel(
        combinedSoilMoisture >= 0.25f,
        combinedSoilMoisture < 0.40f
    )

    $w : DerivedWeatherDataModel()
then
    float sm = $s.getCombinedSoilMoisture();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.55f * (1f - sm))
      + (0.30f * dry)
      + (0.15f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildIrrigationOutput(
            "increase_irrigation_frequency",
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        );

    out.setRationale(
        "Soil moisture is below the recommended cultivation range."
    );

    out.addEvidence(
        "Soil Moisture",
        sm,
        0.40f,
        "<"
    );

    out.addEvidence(
        "Evaporation Drying Risk",
        dry,
        0.60f,
        ">"
    );

    out.addEvidence(
        "Rain Impact Index",
        rain,
        0.75f,
        "<"
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   MODERATE - ADJUST IRRIGATION
   ========================================================= */
rule "IRR - Moderate Irrigation"
salience 80
when
    $s : DerivedSensorDataModel(
        combinedSoilMoisture >= 0.40f,
        combinedSoilMoisture < 0.60f
    )

    $w : DerivedWeatherDataModel()
then
    float sm = $s.getCombinedSoilMoisture();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.45f * sm)
      + (0.35f * (1f - dry))
      + (0.20f * rain);

    EngineCategoryOutputDTO out =
        buildIrrigationOutput(
            "maintain_or_adjust_irrigation",
            SeverityLevel.MODERATE,
            PriorityLevel.P2,
            confidence
        );

    out.setRationale(
        "Soil moisture remains within an acceptable cultivation range."
    );

    out.addEvidence(
        "Soil Moisture",
        sm,
        0.40f,
        ">="
    );

    out.addEvidence(
        "Soil Moisture",
        sm,
        0.60f,
        "<"
    );

    out.addEvidence(
        "Rain Impact Index",
        rain,
        0.50f,
        ">="
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   LOW - MAINTAIN IRRIGATION
   ========================================================= */
rule "IRR - Maintain Irrigation"
salience 70
when
    $s : DerivedSensorDataModel(
        combinedSoilMoisture >= 0.60f
    )

    $w : DerivedWeatherDataModel()
then
    float sm = $s.getCombinedSoilMoisture();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.55f * sm)
      + (0.25f * (1f - dry))
      + (0.20f * rain);

    EngineCategoryOutputDTO out =
        buildIrrigationOutput(
            "maintain_current_irrigation_schedule",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            confidence
        );

    out.setRationale(
        "Soil moisture is within the optimal cultivation range."
    );

    out.addEvidence(
        "Soil Moisture",
        sm,
        0.60f,
        ">="
    );

    out.addEvidence(
        "Rain Impact Index",
        rain,
        0.50f,
        ">="
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   FALLBACK - GUARANTEED SAFE OUTPUT
   ========================================================= */
rule "IRR - Fallback"
salience -999
when
    $s : DerivedSensorDataModel()
then
    EngineCategoryOutputDTO out =
        buildIrrigationOutput(
            "monitor_conditions_only",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            0.05f
        );

    out.setRationale(
        "No irrigation condition requiring intervention was detected."
    );

    intermediateOutputs.add(out);
end
