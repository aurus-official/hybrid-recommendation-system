package rules.microclimate

import com.aurus.server.engine.EngineCategoryOutputDTO;
import com.aurus.server.batch.derive.weather.DerivedWeatherDataModel;
import com.aurus.server.batch.derive.sensor.DerivedSensorDataModel;
import com.aurus.server.shared.PriorityLevel;
import com.aurus.server.shared.SeverityLevel;
import com.aurus.server.shared.CategoryType;

global java.util.List intermediateOutputs;


/* =========================================================
   SHARED FUNCTIONS
   ========================================================= */

function float clampConfidence(float c) {
    if (c < 0f) return 0f;
    if (c > 1f) return 1f;
    return c;
}


/* =========================================================
   FACTORY FUNCTION
   ========================================================= */

function EngineCategoryOutputDTO buildMicroclimateOutput(
    String action,
    SeverityLevel severity,
    PriorityLevel priority,
    float confidence
) {
    EngineCategoryOutputDTO out = new EngineCategoryOutputDTO();

    out.setCategoryType(CategoryType.MICROCLIMATE);
    out.setAction(action);
    out.setSeverityLevel(severity);
    out.setPriorityLevel(priority);

    float multiplier;

    if (severity == SeverityLevel.CRITICAL) {
        multiplier = 1.15f;
    } else if (severity == SeverityLevel.HIGH) {
        multiplier = 1.08f;
    } else if (severity == SeverityLevel.MODERATE) {
        multiplier = 1.00f;
    } else {
        multiplier = 0.95f;
    }

    float scaledConfidence = confidence * multiplier;

    out.setConfidence(
        clampConfidence(scaledConfidence)
    );

    return out;
}


/* =========================================================
   CRITICAL - EMERGENCY COOLING
   ========================================================= */

rule "MC - Emergency Cooling"
salience 100
when
    $s : DerivedSensorDataModel(
        heatStressIndex >= 0.70f
    )

    $w : DerivedWeatherDataModel()
then

    float heat = $s.getHeatStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.75f * heat)
      + (0.15f * (1f - dry))
      + (0.10f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildMicroclimateOutput(
            "apply_emergency_cooling_and_full_shading",
            SeverityLevel.CRITICAL,
            PriorityLevel.P0,
            confidence
        );

    out.setRationale(
        "Severe heat stress detected requiring immediate microclimate intervention."
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.70f,
        ">="
    );

    out.addEvidence(
        "Evaporation Drying Risk",
        dry,
        0.70f,
        ">"
    );

    out.addEvidence(
        "Rain Impact Index",
        rain,
        0.75f,
        "<"
    );

    intermediateOutputs.add(out);

end


/* =========================================================
   HIGH - STRONG HEAT MITIGATION
   ========================================================= */

rule "MC - Strong Cooling Response"
salience 90
when
    $s : DerivedSensorDataModel(
        heatStressIndex >= 0.55f,
        heatStressIndex < 0.70f
    )

    $w : DerivedWeatherDataModel()
then

    float heat = $s.getHeatStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.65f * heat)
      + (0.20f * (1f - dry))
      + (0.15f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildMicroclimateOutput(
            "increase_shading_and_reduce_heat_exposure",
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        );

    out.setRationale(
        "Elevated heat stress levels indicate the need for additional shading."
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.55f,
        ">="
    );

    out.addEvidence(
        "Rain Impact Index",
        rain,
        0.75f,
        "<"
    );

    intermediateOutputs.add(out);

end


/* =========================================================
   MODERATE - ACTIVE MONITORING
   ========================================================= */

rule "MC - Moderate Heat Management"
salience 80
when
    $s : DerivedSensorDataModel(
        heatStressIndex >= 0.35f,
        heatStressIndex < 0.55f
    )

    $w : DerivedWeatherDataModel()
then

    float heat = $s.getHeatStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.55f * heat)
      + (0.25f * (1f - dry))
      + (0.20f * rain);

    EngineCategoryOutputDTO out =
        buildMicroclimateOutput(
            "apply_partial_shading_and_monitor_conditions",
            SeverityLevel.MODERATE,
            PriorityLevel.P2,
            confidence
        );

    out.setRationale(
        "Moderate heat stress detected. Preventive microclimate management is recommended."
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.35f,
        ">="
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.55f,
        "<"
    );

    intermediateOutputs.add(out);

end


/* =========================================================
   LOW - STABLE CONDITIONS
   ========================================================= */

rule "MC - Stable Conditions"
salience 70
when
    $s : DerivedSensorDataModel(
        heatStressIndex >= 0.15f,
        heatStressIndex < 0.35f
    )

    $w : DerivedWeatherDataModel()
then

    float heat = $s.getHeatStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.70f * (1f - heat))
      + (0.15f * (1f - dry))
      + (0.15f * rain);

    EngineCategoryOutputDTO out =
        buildMicroclimateOutput(
            "maintain_light_shading_and_continue_monitoring",
            SeverityLevel.MODERATE,
            PriorityLevel.P2,
            confidence
        );

    out.setRationale(
        "Environmental conditions remain generally stable with minor heat exposure."
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.15f,
        ">="
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.35f,
        "<"
    );

    intermediateOutputs.add(out);

end


/* =========================================================
   OPTIMAL CONDITIONS
   ========================================================= */

rule "MC - Optimal Conditions"
salience 60
when
    $s : DerivedSensorDataModel(
        heatStressIndex < 0.15f
    )

    $w : DerivedWeatherDataModel()
then

    float heat = $s.getHeatStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.80f * (1f - heat))
      + (0.10f * (1f - dry))
      + (0.10f * rain);

    EngineCategoryOutputDTO out =
        buildMicroclimateOutput(
            "maintain_current_microclimate_conditions",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            confidence
        );

    out.setRationale(
        "Microclimate conditions are currently within the optimal cultivation range."
    );

    out.addEvidence(
        "Heat Stress Index",
        heat,
        0.15f,
        "<"
    );

    intermediateOutputs.add(out);

end


/* =========================================================
   FALLBACK - GUARANTEED SAFE OUTPUT
   ========================================================= */

rule "MC - Fallback Monitor"
salience -999
when
    $s : DerivedSensorDataModel()
then

    EngineCategoryOutputDTO out =
        buildMicroclimateOutput(
            "monitor_microclimate_conditions",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            0.05f
        );

    out.setRationale(
        "No microclimate intervention requiring action was detected."
    );

    intermediateOutputs.add(out);

end
