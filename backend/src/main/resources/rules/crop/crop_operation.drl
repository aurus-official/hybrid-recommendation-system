package rules.crop

import com.aurus.server.engine.EngineCategoryOutputDTO;
import com.aurus.server.batch.derive.weather.DerivedWeatherDataModel;
import com.aurus.server.batch.derive.sensor.DerivedSensorDataModel;
import com.aurus.server.shared.PriorityLevel;
import com.aurus.server.shared.SeverityLevel;
import com.aurus.server.shared.CategoryType;

global java.util.List intermediateOutputs;


/* =========================================================
   SHARED FUNCTIONS
   ========================================================= */

function float clampConfidence(float c) {
    if (c < 0f) return 0f;
    if (c > 1f) return 1f;
    return c;
}

function EngineCategoryOutputDTO buildCropOutput(
    String action,
    SeverityLevel severity,
    PriorityLevel priority,
    float confidence
) {
    EngineCategoryOutputDTO out = new EngineCategoryOutputDTO();

    out.setCategoryType(CategoryType.CROP_OPERATION);
    out.setAction(action);
    out.setSeverityLevel(severity);
    out.setPriorityLevel(priority);

    float multiplier;

    if (severity == SeverityLevel.CRITICAL) {
        multiplier = 1.15f;
    } else if (severity == SeverityLevel.HIGH) {
        multiplier = 1.08f;
    } else if (severity == SeverityLevel.MODERATE) {
        multiplier = 1.00f;
    } else {
        multiplier = 0.95f;
    }

    out.setConfidence(clampConfidence(confidence * multiplier));
    return out;
}


/* =========================================================
   CRITICAL - EXTREME STRESS
   ========================================================= */

rule "Crop - Extreme Stress Emergency"
salience 100
when
    $s : DerivedSensorDataModel(
        plantStressIndex >= 0.68f ||
        heatStressIndex >= 0.72f
    )
    $w : DerivedWeatherDataModel()
then

    float psi = $s.getPlantStressIndex();
    float hsi = $s.getHeatStressIndex();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.55f * psi)
      + (0.35f * hsi)
      + (0.10f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Immediately relocate planter box to a shaded or cooler balcony area and avoid any handling or disturbance of the plant.",
            SeverityLevel.CRITICAL,
            PriorityLevel.P0,
            confidence
        );

    out.setRationale(
        "Severe environmental stress detected in pechay grown in a container system, indicating high risk of rapid wilting, loss of turgidity, and irreversible leaf damage. Balcony conditions may be amplifying heat exposure; immediate relocation and reduction of stress exposure are required."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   HIGH - HEAT RESTRICTION
   ========================================================= */

rule "Crop - Limit Midday Operations"
salience 90
when
    $s : DerivedSensorDataModel(
        heatStressIndex >= 0.60f,
        heatStressIndex < 0.72f
    )
    $w : DerivedWeatherDataModel()
then

    float hsi = $s.getHeatStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.70f * hsi)
      + (0.20f * (1f - dry))
      + (0.10f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Avoid midday exposure of planter box to direct sunlight; move to shaded balcony area or apply temporary shading cover.",
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        );

    out.setRationale(
        "Elevated heat conditions increase transpiration and moisture loss in container-grown pechay, where soil volume is limited and heats up faster than ground soil. Reducing direct sun exposure helps stabilize leaf turgidity."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   HIGH - DELAY OPERATIONS
   ========================================================= */

rule "Crop - Delay Non Essential Operations"
salience 85
when
    $s : DerivedSensorDataModel(
        plantStressIndex >= 0.52f,
        plantStressIndex < 0.68f
    )
    $w : DerivedWeatherDataModel()
then

    float psi = $s.getPlantStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.70f * psi)
      + (0.20f * (1f - dry))
      + (0.10f * (1f - rain));

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Delay non-essential container handling such as pruning, repotting, or repositioning of the planter box until plant stabilizes.",
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        );

    out.setRationale(
        "Container-grown pechay under elevated stress becomes more sensitive to disturbance due to limited root space and faster moisture fluctuation in planter boxes."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   HIGH - RAINFALL ADJUSTMENT
   ========================================================= */

rule "Crop - Rainfall Operation Adjustment"
salience 80
when
    $w : DerivedWeatherDataModel(
        rainImpactIndex >= 0.68f
    )
    $s : DerivedSensorDataModel()
then

    float rain = $w.getRainImpactIndex();
    float psi = $s.getPlantStressIndex();

    float confidence =
        (0.70f * rain)
      + (0.30f * (1f - psi));

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Ensure planter box has unobstructed drainage holes and elevate container to prevent waterlogging during heavy rainfall.",
            SeverityLevel.HIGH,
            PriorityLevel.P1,
            confidence
        );

    out.setRationale(
        "Heavy rainfall increases water retention risk in container systems, but drainage holes may still be insufficient under sustained rain. Proper elevation prevents root stress caused by saturation."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   MODERATE - CONTROLLED OPERATIONS
   ========================================================= */

rule "Crop - Controlled Operations"
salience 75
when
    $s : DerivedSensorDataModel(
        plantStressIndex >= 0.35f,
        plantStressIndex < 0.52f
    )
    $w : DerivedWeatherDataModel()
then

    float psi = $s.getPlantStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.55f * psi)
      + (0.25f * (1f - dry))
      + (0.20f * rain);

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Perform light container care while minimizing disturbance, such as gentle watering and avoiding soil compression.",
            SeverityLevel.MODERATE,
            PriorityLevel.P2,
            confidence
        );

    out.setRationale(
        "Moderate stress in container-grown pechay indicates early imbalance in moisture and heat regulation, requiring careful handling to avoid additional fluctuation."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   LOW - ROUTINE OPERATIONS
   ========================================================= */

rule "Crop - Continue Routine Operations"
salience 65
when
    $s : DerivedSensorDataModel(
        plantStressIndex >= 0.18f,
        plantStressIndex < 0.35f
    )
    $w : DerivedWeatherDataModel()
then

    float psi = $s.getPlantStressIndex();
    float dry = $s.getEvaporationDryingRisk();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.70f * (1f - psi))
      + (0.15f * (1f - dry))
      + (0.15f * rain);

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Continue routine container care including watering, monitoring drainage, and light maintenance.",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            confidence
        );

    out.setRationale(
        "Container-grown pechay remains stable with adequate moisture and heat balance. Regular monitoring ensures early detection of stress changes common in small soil-volume systems."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   OPTIMAL CONDITIONS
   ========================================================= */

rule "Crop - Optimal Conditions"
salience 60
when
    $s : DerivedSensorDataModel(
        plantStressIndex < 0.18f,
        heatStressIndex < 0.22f
    )
    $w : DerivedWeatherDataModel()
then

    float psi = $s.getPlantStressIndex();
    float hsi = $s.getHeatStressIndex();
    float rain = $w.getRainImpactIndex();

    float confidence =
        (0.75f * (1f - psi))
      + (0.15f * (1f - hsi))
      + (0.10f * rain);

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Proceed with normal container gardening activities under stable balcony conditions.",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            confidence
        );

    out.setRationale(
        "Pechay is in stable condition within a container environment, with balanced moisture and heat exposure suitable for normal growth."
    );

    intermediateOutputs.add(out);
end


/* =========================================================
   FALLBACK
   ========================================================= */

rule "Crop - Fallback Monitoring"
salience -999
when
    $s : DerivedSensorDataModel()
then

    EngineCategoryOutputDTO out =
        buildCropOutput(
            "Continue monitoring container conditions before performing any major handling or repositioning of planter box.",
            SeverityLevel.LOW,
            PriorityLevel.P3,
            0.05f
        );

    out.setRationale(
        "No critical stress detected in container-grown pechay. Continued monitoring is recommended due to rapid microclimate changes typical in balcony environments."
    );

    intermediateOutputs.add(out);

end
