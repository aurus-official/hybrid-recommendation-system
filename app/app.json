{
  "expo": {
    "scheme": "pechai",
    "name": "PechAI",
    "slug": "app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.expo.hybridrecommendationsystem",
      "googleServicesFile": "../google-services.json",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "hidden": false,
          "style": "dark"
        }
      ],
      "react-native-navigation-mode"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d12c6ea-a771-4a4e-8657-c60b1190217a"
      },
      "expo-navigation-bar": {
        "enforceContrast": true,
        "hidden": false,
        "style": "dark"
      }
    },
    "owner": "rururus223"
  }
}
